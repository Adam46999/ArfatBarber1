              </div>
              <div className="mt-0.5 text-[7px] tracking-[0.3em] text-white/50">
                BARBER
              </div>
            </div>
          </div>
        )}

        {product.featured && (
          <span className="absolute start-2 top-2 rounded-full bg-[#f0d69a] px-2 py-1 text-[8px] font-black text-[#16130e] shadow-sm sm:text-[9px]">
            {labels.recommended}
          </span>
