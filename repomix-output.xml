/* src/pages/barberPanel/BarberMobileApp.css */

.barber-mobile-app {
  position: relative;

  width: 100%;
  height: 100dvh;

  overflow: hidden;

  background: #f1f5f9;

  /*
    منع تحديد النصوص أثناء
    السحب الأفقي بالخطأ.
  */
  -webkit-tap-highlight-color: transparent;
}

/* الحاوية الخارجية للصفحات */
.barber-pages-viewport {
  position: absolute;
  inset: 0;

  overflow: hidden;

  /*
    نسمح بالتمرير العمودي الطبيعي،
    لكن الحركة الأفقية يديرها
    Framer Motion.
  */
  touch-action: pan-y pinch-zoom;

  overscroll-behavior-x: none;
  overscroll-behavior-y: none;

  cursor: grab;
}

.barber-pages-viewport.is-dragging {
  cursor: grabbing;

  -webkit-user-select: none;
  user-select: none;
}

/* المسار الذي يحتوي جميع الصفحات */
.barber-pages-track {
  display: flex;
  flex-direction: row;

  width: 100%;
  height: 100%;

  direction: ltr;

  will-change: transform;

  transform: translateZ(0);

  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;

  perspective: 1000px;
}

/* كل صفحة */
.barber-page-slide {
  position: relative;

  flex: 0 0 100%;

  width: 100%;
  min-width: 100%;
  max-width: 100%;

  height: 100%;

  overflow-x: hidden;
  overflow-y: auto;

  direction: rtl;

  overscroll-behavior-y: contain;

  padding-bottom: calc(112px + env(safe-area-inset-bottom));

  -webkit-overflow-scrolling: touch;

  /*
    يساعد المتصفح على عزل رسم
    كل صفحة وتحسين السحب.
  */
  contain: layout paint style;

  transform: translateZ(0);

  backface-visibility: hidden;

  -webkit-backface-visibility: hidden;
}

.barber-page-slide > * {
  width: 100%;
  min-height: 100%;
}

/*
  إخفاء شريط التنقل القديم
  داخل صفحة إدارة الساعات فقط.
*/
.barber-manage-slide > div > div:nth-child(2) > div:first-child > div.mt-4 {
  display: none !important;
}

/* =========================================================
   PREMIUM BARBER BOTTOM NAV
   mobile-first / thumb-friendly / RTL-safe
   ========================================================= */

.barber-floating-nav {
  position: fixed;
  z-index: 110;

  right: 10px;
  left: 10px;
  bottom: calc(10px + env(safe-area-inset-bottom));

  height: 76px;

  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: stretch;

  padding: 6px;

  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 24px;

  background:
    linear-gradient(
      180deg,
      rgba(32, 39, 45, 0.985) 0%,
      rgba(22, 28, 33, 0.995) 100%
    );

  box-shadow:
    0 18px 42px rgba(0, 0, 0, 0.30),
    0 5px 16px rgba(0, 0, 0, 0.20),
    inset 0 1px 0 rgba(255, 255, 255, 0.045);

  backdrop-filter: blur(20px) saturate(115%);
  -webkit-backdrop-filter: blur(20px) saturate(115%);

  isolation: isolate;
  transform: translateZ(0);
}

.barber-nav-item {
  position: relative;

  min-width: 0;
  min-height: 60px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 4px;

  padding: 7px 2px 8px;

  border: 0;
  border-radius: 17px;

  outline: none;

  background: transparent;
  color: rgba(218, 225, 229, 0.62);

  cursor: pointer;

  transition:
    color 150ms ease,
    background-color 150ms ease,
    transform 120ms ease,
    box-shadow 150ms ease;

  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}

.barber-nav-item::after {
  content: "";

  position: absolute;

  right: 31%;
  left: 31%;
  bottom: 4px;

  height: 3px;

  border-radius: 999px;

  background: transparent;

  transform: scaleX(0.45);

  transition:
    background-color 160ms ease,
    transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

.barber-nav-item:hover {
  color: rgba(255, 255, 255, 0.78);
}

.barber-nav-item:active {
  transform: scale(0.96);
}

.barber-nav-item:focus-visible {
  box-shadow:
    inset 0 0 0 2px rgba(126, 181, 170, 0.72);
}

.barber-nav-item.is-active {
  color: #82b8ad;

  background:
    linear-gradient(
      180deg,
      rgba(111, 166, 155, 0.16) 0%,
      rgba(111, 166, 155, 0.07) 100%
    );

  box-shadow:
    inset 0 0 0 1px rgba(126, 177, 167, 0.14),
    0 5px 16px rgba(0, 0, 0, 0.14);
}

.barber-nav-item.is-active::after {
  background: #78a99f;
  transform: scaleX(1);
}

.barber-nav-icon {
  display: grid;
  place-items: center;

  width: 24px;
  height: 24px;

  flex-shrink: 0;

  font-size: 20px;
  line-height: 1;

  transition:
    transform 160ms cubic-bezier(0.22, 1, 0.36, 1),
    color 150ms ease;
}

.barber-nav-icon svg {
  display: block;

  width: 1em;
  height: 1em;
}

.barber-nav-item.is-active .barber-nav-icon {
  transform: translateY(-1px) scale(1.03);
}

.barber-nav-label {
  display: block;

  width: 100%;
  min-width: 0;

  overflow: hidden;

  color: currentColor;

  font-size: 9.5px;
  font-weight: 800;
  line-height: 1.1;

  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.barber-nav-item.is-active .barber-nav-label {
  font-weight: 900;
}

/* overlay when More is open */
.barber-nav-backdrop {
  position: fixed;
  z-index: 101;

  inset: 0;

  border: 0;

  background: rgba(8, 9, 10, 0.22);

  backdrop-filter: blur(1.5px);
  -webkit-backdrop-filter: blur(1.5px);
}

/* More menu */
.barber-more-menu {
  position: fixed;
  z-index: 109;

  left: 12px;
  bottom: calc(98px + env(safe-area-inset-bottom));

  width: min(224px, calc(100vw - 24px));

  display: grid;
  gap: 5px;

  padding: 7px;

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;

  background:
    linear-gradient(
      180deg,
      rgba(35, 43, 49, 0.995),
      rgba(22, 28, 33, 0.995)
    );

  box-shadow:
    0 18px 46px rgba(0, 0, 0, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.045);

  color: white;

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.barber-more-menu-item {
  min-height: 50px;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 10px 12px;

  border: 0;
  border-radius: 14px;

  background: transparent;
  color: rgba(229, 235, 238, 0.88);

  font-size: 13px;
  font-weight: 800;

  text-align: right;

  transition:
    background-color 140ms ease,
    color 140ms ease,
    transform 120ms ease;

  touch-action: manipulation;
}

.barber-more-menu-item:hover {
  background: rgba(255, 255, 255, 0.055);
  color: #91beb5;
}

.barber-more-menu-item:active {
  transform: scale(0.985);
}

.barber-more-menu-icon {
  display: grid;
  place-items: center;

  width: 30px;
  height: 30px;

  flex-shrink: 0;

  border-radius: 10px;

  background: rgba(111, 166, 155, 0.12);
  color: #86b6ad;

  font-size: 15px;
}

/* keep page content clear from nav */
.barber-page-slide {
  padding-bottom:
    calc(112px + env(safe-area-inset-bottom));
}

/* compact phones */
@media (max-width: 380px) {
  .barber-floating-nav {
    right: 6px;
    left: 6px;

    height: 72px;

    padding: 5px;

    border-radius: 21px;
  }

  .barber-nav-item {
    min-height: 58px;
    gap: 3px;

    padding-inline: 1px;

    border-radius: 15px;
  }

  .barber-nav-icon {
    width: 22px;
    height: 22px;

    font-size: 18px;
  }

  .barber-nav-label {
    font-size: 8.5px;
  }

  .barber-more-menu {
    left: 8px;
    bottom: calc(92px + env(safe-area-inset-bottom));
  }
}

/* very narrow phones */
@media (max-width: 340px) {
  .barber-floating-nav {
    right: 4px;
    left: 4px;
  }

  .barber-nav-label {
    font-size: 8px;
  }

  .barber-nav-icon {
    font-size: 17px;
  }
}

/* tablet / desktop */
@media (min-width: 900px) {
  .barber-floating-nav {
    right: 50%;
    left: auto;

    width: min(620px, calc(100vw - 40px));

    transform: translateX(50%) translateZ(0);
  }

  .barber-more-menu {
    left: calc(50% - 310px);
  }
}
/* احترام إعداد تقليل الحركة */
@media (prefers-reduced-motion: reduce) {
  .barber-nav-item,
  .barber-nav-icon,
  .barber-nav-label {
    transition-duration: 1ms !important;
  }
}


/* =========================================================
   PREMIUM QUIET TAB TRANSITION
   Tab taps = calm content settle
   Swipe gesture = physical spring track movement
   ========================================================= */

@keyframes barberTabContentSettle {
  0% {
    opacity: 0.72;
    transform: translateY(5px) scale(0.995);
  }

  55% {
    opacity: 0.96;
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.barber-page-slide.is-active > * {
  animation:
    barberTabContentSettle
    190ms
    cubic-bezier(0.22, 1, 0.36, 1)
    both;
}

/* Active navigation feedback should finish before the eye
   starts following the page content. */
.barber-nav-item {
  transition:
    color 130ms ease,
    background-color 140ms ease,
    transform 100ms ease,
    box-shadow 140ms ease;
}

.barber-nav-item:active {
  transform: scale(0.965);
}

@media (prefers-reduced-motion: reduce) {
  .barber-page-slide.is-active > * {
    animation: none !important;
  }
}
</file>

