export default function RamadanCurve({
  message = "رمضان كريم",
  subMessage = "أعاده الله علينا وعليكم باليُمن والبركات",
  curveAmount = 85,
  debug = false,
}) {
  const pathRef = useRef(null);

  const fullText = useMemo(() => {
    // جملة واحدة فقط
    return `${message}  🌙  ✧  ${subMessage}`;
