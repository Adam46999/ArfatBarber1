      }

      if (event.key === "ArrowRight") {
        viewerSwiper.slideNext();
      }
    };

    window.addEventListener("keydown", handleViewerKeys);

    return () => {
      window.removeEventListener("keydown", handleViewerKeys);
    };
  }, [openedImage, viewerSwiper]);

