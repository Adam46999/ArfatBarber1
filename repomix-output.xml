    id: "stats",
    path: "/barber/stats",
    shortLabel: "إحصائيات",
    fullLabel: "الإحصائيات",
    icon: FaChartBar,
    component: Dashboard,
  },
  {
    id: "reviews",
    path: "/barber/reviews",
    shortLabel: "تقييمات",
    fullLabel: "إدارة التقييمات",
    icon: FaStar,
    component: ReviewsManagerPage,
  },
  {
    id: "weekly-hours",
    path: "/barber/weekly-hours",
    shortLabel: "أسبوعي",
    fullLabel: "ساعات العمل الأسبوعية",
    icon: FaCalendarAlt,
    component: WeeklyHoursPage,
  },
  {
    id: "blocked",
    path: "/barber/blocked",
    shortLabel: "محظورون",
