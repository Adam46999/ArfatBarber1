            <div className="rounded-[22px] border border-[#eadfca] bg-[linear-gradient(180deg,#fffdf8_0%,#fbf7ee_100%)] p-3 shadow-[0_10px_30px_rgba(128,94,22,0.08)] sm:p-4">
