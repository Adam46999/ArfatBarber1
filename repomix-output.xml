            key={starValue}
            type="button"
            disabled={readonly}
            onClick={() => onChange?.(starValue)}
            role={readonly ? undefined : "radio"}
            aria-checked={readonly ? undefined : selected === starValue}
            aria-label={`${starValue} نجوم`}
            className={`rounded-md leading-none transition duration-200 ${
