                ? "cursor-default"
                : "cursor-pointer hover:-translate-y-1 hover:scale-110 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold/40"
            } ${active ? "text-gold drop-shadow-sm" : "text-gray-300"}`}
            style={{
              fontSize: size,
            }}
          >
            ★
          </button>
        );
      })}
    </div>
  );
}

