            </div>
          </button>
        </div>

        <p className="text-xs text-gray-500">
          {limitOnePerDay
            ? "مُفعَّل: لا يمكن لنفس الرقم حجز أكثر من موعد في نفس اليوم."
            : "مُعطَّل: يمكن لنفس الرقم حجز أكثر من موعد في نفس اليوم."}
        </p>
      </div>
    </div>
  );
}
</file>

