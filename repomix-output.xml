        </div>

        {oldDate && newDate ? (
          <div className="w-full rounded-[16px] border border-[#e7dfcf] bg-gradient-to-b from-[#fffdf8] to-[#faf7f0] p-4 text-right shadow-[0_6px_18px_rgba(31,24,12,0.05)]">
