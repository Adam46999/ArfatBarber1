          <h3 className="truncate text-[12px] font-black leading-5 text-[#111] sm:text-[14px]">
            {product.name}
          </h3>

          <p className="truncate text-[9px] font-medium text-black/45 sm:text-[11px]">
            {product.brand || ""}
