                {editing ? "تعديل المنتج" : "إضافة منتج"}
              </h2>
              <p className="mt-1 text-[11px] font-medium leading-4 text-black/45">
                التغييرات تظهر مباشرة على الكرت قبل الحفظ.
              </p>
            </div>

            <button
              type="button"
