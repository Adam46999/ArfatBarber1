              onClick={onAdminToggleFeatured}
              className={`grid min-h-[40px] min-w-[40px] place-items-center rounded-lg transition active:scale-[0.97] disabled:opacity-50 ${
                product.featured
                  ? "bg-[#f1d99d] text-[#684912] ring-1 ring-[#c49a3a]/25"
